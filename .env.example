# ========================================================
# KATALOG DIGITAL UMKM DESA DADAPAYU - ENVIRONMENT CONFIG
# Salin file ini menjadi .env untuk development lokal
# ========================================================

# Firebase Client (Bisa diakses di frontend)
PUBLIC_FIREBASE_API_KEY=AIzaSy...
PUBLIC_FIREBASE_AUTH_DOMAIN=umkm-dadapayu.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=umkm-dadapayu
PUBLIC_FIREBASE_STORAGE_BUCKET=umkm-dadapayu.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Cloudinary Public
PUBLIC_CLOUDINARY_CLOUD_NAME=desa-dadapayu

# Cloudinary Server Secret (HANYA di backend/Cloudflare Pages Secret, JANGAN bocor ke frontend)
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Kunci Inisiasi Admin Pertama Kali (Digunakan saat setup awal admin desa)
ADMIN_SETUP_SECRET=replace-with-a-strong-random-secret
