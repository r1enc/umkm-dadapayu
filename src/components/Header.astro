---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/katalog', label: 'Katalog UMKM' },
  { href: '/kategori', label: 'Kategori' },
  { href: '/tentang', label: 'Tentang Desa' },
];
---

<header class="relative z-40 border-b border-village-800 bg-village-900 text-white">
  <div class="mx-auto flex h-[4.25rem] max-w-7xl items-center justify-between gap-3 px-4 sm:h-[4.75rem] sm:px-6 lg:px-8">
    <a href="/" class="flex min-w-0 items-center gap-2.5 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#c8e879] sm:gap-3">
      <img src="/images/logo-dadapayu.png" alt="" aria-hidden="true" class="h-9 w-9 shrink-0 object-contain sm:h-10 sm:w-10" />
      <span class="min-w-0">
        <span class="block truncate text-sm font-bold leading-tight tracking-tight sm:text-base">UMKM Dadapayu</span>
        <span class="mt-0.5 block truncate text-[10px] leading-tight text-village-200 sm:text-xs">Semanu, Gunungkidul</span>
      </span>
    </a>

    <nav aria-label="Navigasi utama" class="hidden items-center gap-1 md:flex">
      {navLinks.map((link) => {
        const active = link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
        return (
          <a href={link.href} aria-current={active ? 'page' : undefined} class:list={['rounded-full px-4 py-2 text-sm font-medium transition-colors', active ? 'bg-[#c8e879] text-village-900' : 'text-village-100 hover:bg-village-800 hover:text-white']}>
            {link.label}
          </a>
        );
      })}
    </nav>

    <a href="/admin" class="inline-flex min-h-10 shrink-0 items-center justify-center gap-2 rounded-full border border-village-600 px-3 text-xs font-semibold text-village-100 transition hover:border-[#c8e879] hover:text-white sm:px-4 sm:text-sm">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <span class="hidden sm:inline">Admin Desa</span>
      <span class="sm:hidden">Admin</span>
    </a>
  </div>
</header>
