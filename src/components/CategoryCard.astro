---
import type { Category } from '../types';
import { getCategoryUMKMCount } from '../data/mockData';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const count = getCategoryUMKMCount(category.id);

// Pilihan icon berdasarkan slug kategori
let iconPath = 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z'; // default belanja
if (category.slug.includes('kuliner')) {
  iconPath = 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253';
} else if (category.slug.includes('kerajinan')) {
  iconPath = 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01';
} else if (category.slug.includes('bumi') || category.slug.includes('pertanian')) {
  iconPath = 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z';
} else if (category.slug.includes('jasa') || category.slug.includes('warung')) {
  iconPath = 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4';
}
---

<a
  href={`/kategori/${category.slug}`}
  class="group flex items-center gap-4 rounded-2xl bg-white p-4 sm:p-5 border border-gray-200/80 shadow-xs hover:border-village-300 hover:shadow-md transition-all duration-200"
>
  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-village-50 text-village-700 transition group-hover:bg-village-700 group-hover:text-white">
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPath} />
    </svg>
  </div>
  <div class="min-w-0 flex-1">
    <h3 class="text-sm sm:text-base font-bold text-gray-900 group-hover:text-village-700 transition line-clamp-1">
      {category.name}
    </h3>
    <p class="text-xs text-gray-500 mt-0.5">
      {count} UMKM terdaftar
    </p>
  </div>
  <div class="text-gray-400 group-hover:text-village-700 transition group-hover:translate-x-1">
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
