---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const links = [
  { href: '/', label: 'Beranda', path: '/', icon: 'M3 10.5 12 3l9 7.5M5.5 9v11h13V9M9 20v-6h6v6' },
  { href: '/katalog', label: 'Katalog', path: '/katalog', icon: 'M4 5h16M4 12h16M4 19h16' },
  { href: '/kategori', label: 'Kategori', path: '/kategori', icon: 'M4 5h6v6H4zM14 5h6v6h-6zM4 15h6v6H4zM14 15h6v6h-6z' },
  { href: '/tentang', label: 'Desa', path: '/tentang', icon: 'M12 21s7-4.4 7-11a7 7 0 1 0-14 0c0 6.6 7 11 7 11zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z' },
];
---

<nav aria-label="Navigasi utama" class="fixed inset-x-0 bottom-0 z-50 border-t border-village-200 bg-[#fbfaf5]/95 px-2 pt-2 pb-[calc(0.5rem+env(safe-area-inset-bottom))] shadow-[0_-8px_24px_rgba(18,46,35,0.08)] backdrop-blur md:hidden">
  <ul class="mx-auto grid max-w-md grid-cols-4 gap-1">
    {links.map((link) => {
      const active = link.path === '/' ? currentPath === '/' : currentPath.startsWith(link.path);
      return (
        <li>
          <a href={link.href} aria-current={active ? 'page' : undefined} class:list={['flex min-h-12 flex-col items-center justify-center gap-1 rounded-xl text-[10px] font-semibold transition-colors', active ? 'bg-village-900 text-white' : 'text-village-700 hover:bg-village-100']}>
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <path d={link.icon} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {link.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
