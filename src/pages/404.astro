---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Halaman Tidak Ditemukan (404) — Katalog UMKM Dadapayu"
  description="Halaman yang Anda tuju tidak ditemukan atau telah dipindahkan."
>
  <div class="flex min-h-[60vh] flex-col items-center justify-center px-4 py-16 text-center">
    <div class="flex h-20 w-20 items-center justify-center rounded-3xl bg-village-100 text-village-800 text-3xl font-extrabold mb-6">
      404
    </div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
      Halaman Tidak Ditemukan
    </h1>
    <p class="mt-2 max-w-md text-sm text-gray-600 leading-relaxed">
      Profil UMKM atau halaman yang Anda cari mungkin telah dinonaktifkan, diubah tautannya, atau belum terdaftar.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="rounded-xl border border-gray-300 bg-white px-5 py-2.5 text-xs sm:text-sm font-semibold text-gray-700 hover:bg-gray-50 transition"
      >
        Kembali ke Beranda
      </a>
      <a
        href="/katalog"
        class="rounded-xl bg-village-700 px-5 py-2.5 text-xs sm:text-sm font-semibold text-white shadow-xs hover:bg-village-800 transition"
      >
        Lihat Seluruh Katalog UMKM
      </a>
    </div>
  </div>
</Layout>
