---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { fetchAdminCategories } from '../../../lib/services/categoryService';
import { fetchAdminUMKM } from '../../../lib/services/umkmService';

const categories = await fetchAdminCategories(Astro.request);
const allUMKM = await fetchAdminUMKM(Astro.request);

// Hitung berapa UMKM yang menggunakan masing-masing kategori
const categoryUsageMap: Record<string, number> = {};
categories.forEach((cat) => {
  categoryUsageMap[cat.id] = allUMKM.filter((u) => u.categoryId === cat.id).length;
});
---

<AdminLayout title="Kelola Kategori Usaha" activeNav="kategori">
  <div class="space-y-6">
    
    <!-- Header Halaman -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-gray-200">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
          Kategori Usaha
        </h1>
        <p class="text-xs sm:text-sm text-gray-600 mt-1">
          Kelola kelompok sektor usaha (Kuliner, Kerajinan, Hasil Bumi, dll).
        </p>
      </div>

      <button
        id="btn-open-add-cat-modal"
        type="button"
        class="inline-flex items-center gap-2 bg-village-700 hover:bg-village-800 text-white px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold shadow-sm transition"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Tambah Kategori Baru</span>
      </button>
    </div>

    <!-- Kotak Notifikasi -->
    <div id="cat-alert-box" class="hidden rounded-2xl p-4 text-xs font-semibold leading-relaxed"></div>

    <!-- Tabel Kategori -->
    <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-gray-200 bg-gray-50/70 text-gray-600 text-[11px] uppercase tracking-wider">
              <th class="py-3.5 px-4 font-bold">Urutan</th>
              <th class="py-3.5 px-4 font-bold">Nama Kategori</th>
              <th class="py-3.5 px-4 font-bold">Tautan (Slug)</th>
              <th class="py-3.5 px-4 font-bold">Digunakan oleh</th>
              <th class="py-3.5 px-4 font-bold">Status</th>
              <th class="py-3.5 px-4 font-bold text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {categories.map((cat) => {
              const usageCount = categoryUsageMap[cat.id] || 0;
              return (
                <tr class="hover:bg-gray-50/60 transition">
                  <td class="py-3.5 px-4 font-mono font-bold text-gray-500">
                    #{cat.sortOrder}
                  </td>
                  <td class="py-3.5 px-4">
                    <span class="font-bold text-gray-900">{cat.name}</span>
                  </td>
                  <td class="py-3.5 px-4 text-gray-500 font-mono text-xs">
                    {cat.slug}
                  </td>
                  <td class="py-3.5 px-4">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                      {usageCount} UMKM
                    </span>
                  </td>
                  <td class="py-3.5 px-4">
                    <span class:list={[
                      'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold',
                      cat.active
                        ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
                        : 'bg-gray-100 text-gray-600 border border-gray-200',
                    ]}>
                      {cat.active ? 'Aktif' : 'Non-Aktif'}
                    </span>
                  </td>
                  <td class="py-3.5 px-4 text-right">
                    <div class="flex items-center justify-end gap-1.5">
                      <button
                        type="button"
                        class="btn-edit-cat px-3 py-1 bg-village-50 text-village-800 hover:bg-village-700 hover:text-white rounded-lg text-xs font-semibold transition"
                        data-id={cat.id}
                        data-name={cat.name}
                        data-slug={cat.slug}
                        data-order={cat.sortOrder}
                        data-active={cat.active ? 'true' : 'false'}
                      >
                        Edit
                      </button>
                      <button
                        type="button"
                        class="btn-delete-cat p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition"
                        data-id={cat.id}
                        data-name={cat.name}
                        data-usage={usageCount}
                        title="Hapus Kategori"
                      >
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Modal Tambah / Edit Kategori -->
  <div id="cat-modal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 space-y-5 shadow-2xl border border-gray-100">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <h3 id="cat-modal-title" class="text-base font-bold text-gray-900">Tambah Kategori Baru</h3>
        <button id="cat-modal-close" type="button" class="text-gray-400 hover:text-gray-600">✕</button>
      </div>

      <form id="cat-modal-form" class="space-y-4">
        <input type="hidden" id="modal-cat-id" />

        <div>
          <label for="modal-cat-name" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
            Nama Kategori <span class="text-red-500">*</span>
          </label>
          <input
            id="modal-cat-name"
            type="text"
            required
            placeholder="Contoh: Kuliner Tradisional"
            class="w-full rounded-xl border border-gray-300 p-2.5 text-sm focus:outline-none focus:border-village-600 shadow-2xs"
          />
        </div>

        <div>
          <label for="modal-cat-slug" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
            Tautan URL (Slug) <span class="text-red-500">*</span>
          </label>
          <input
            id="modal-cat-slug"
            type="text"
            required
            placeholder="kuliner-tradisional"
            class="w-full rounded-xl border border-gray-300 p-2.5 text-xs font-mono focus:outline-none focus:border-village-600 shadow-2xs bg-gray-50"
          />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="modal-cat-order" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              Nomor Urutan
            </label>
            <input
              id="modal-cat-order"
              type="number"
              value="1"
              class="w-full rounded-xl border border-gray-300 p-2.5 text-sm focus:outline-none focus:border-village-600 shadow-2xs"
            />
          </div>

          <div>
            <label for="modal-cat-active" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">
              Status Tampilan
            </label>
            <select
              id="modal-cat-active"
              class="w-full rounded-xl border border-gray-300 p-2.5 text-sm focus:outline-none focus:border-village-600 shadow-2xs bg-white"
            >
              <option value="true">Aktif (Tampil)</option>
              <option value="false">Non-Aktif</option>
            </select>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-gray-100">
          <button
            id="modal-cat-cancel"
            type="button"
            class="px-4 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-100 rounded-xl transition"
          >
            Batal
          </button>
          <button
            id="modal-cat-submit"
            type="submit"
            class="px-5 py-2 bg-village-700 hover:bg-village-800 text-white rounded-xl text-xs font-bold transition shadow-xs"
          >
            Simpan Kategori
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Konfirmasi Hapus Kategori -->
  <div id="delete-cat-modal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 space-y-4 shadow-2xl border border-gray-100">
      <div class="h-12 w-12 rounded-2xl bg-red-100 text-red-700 flex items-center justify-center">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-gray-900">Hapus Kategori</h3>
        <p id="delete-cat-desc" class="text-xs sm:text-sm text-gray-600 mt-1 leading-relaxed"></p>
      </div>
      <div class="flex items-center justify-end gap-2 pt-2">
        <button
          id="delete-cat-cancel"
          type="button"
          class="px-4 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-100 rounded-xl transition"
        >
          Batal
        </button>
        <button
          id="delete-cat-confirm"
          type="button"
          class="px-4 py-2 text-xs font-bold text-white bg-red-600 hover:bg-red-700 rounded-xl transition shadow-xs"
        >
          Ya, Hapus
        </button>
      </div>
    </div>
  </div>

  <!-- Script Penanganan Kategori Client -->
  <script>
    import { getClientAuth } from '../../../lib/firebase/client';

    const btnOpenAdd = document.getElementById('btn-open-add-cat-modal');
    const modal = document.getElementById('cat-modal');
    const modalTitle = document.getElementById('cat-modal-title');
    const modalClose = document.getElementById('cat-modal-close');
    const modalCancel = document.getElementById('modal-cat-cancel');
    const modalForm = document.getElementById('cat-modal-form') as HTMLFormElement;
    const modalId = document.getElementById('modal-cat-id') as HTMLInputElement;
    const modalName = document.getElementById('modal-cat-name') as HTMLInputElement;
    const modalSlug = document.getElementById('modal-cat-slug') as HTMLInputElement;
    const modalOrder = document.getElementById('modal-cat-order') as HTMLInputElement;
    const modalActive = document.getElementById('modal-cat-active') as HTMLSelectElement;
    // Auto slug
    if (modalName && modalSlug) {
      modalName.addEventListener('input', () => {
        if (!modalId.value) {
          modalSlug.value = modalName.value
            .toLowerCase()
            .replace(/[^\w\s-]/g, '')
            .replace(/[\s_-]+/g, '-')
            .replace(/^-+|-+$/g, '');
        }
      });
    }

    if (btnOpenAdd && modal) {
      btnOpenAdd.addEventListener('click', () => {
        if (modalTitle) modalTitle.textContent = 'Tambah Kategori Baru';
        modalId.value = '';
        modalName.value = '';
        modalSlug.value = '';
        modalOrder.value = '1';
        modalActive.value = 'true';
        modal.classList.remove('hidden');
      });
    }

    [modalClose, modalCancel].forEach((el) => {
      el?.addEventListener('click', () => modal?.classList.add('hidden'));
    });

    // Edit Kategori
    document.querySelectorAll('.btn-edit-cat').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const t = e.currentTarget as HTMLElement;
        if (modalTitle) modalTitle.textContent = 'Edit Kategori';
        modalId.value = t.dataset.id || '';
        modalName.value = t.dataset.name || '';
        modalSlug.value = t.dataset.slug || '';
        modalOrder.value = t.dataset.order || '1';
        modalActive.value = t.dataset.active || 'true';
        modal?.classList.remove('hidden');
      });
    });

    // Form Submit (Create or Update)
    if (modalForm) {
      modalForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const auth = getClientAuth();
        const user = auth.currentUser;
        if (!user) {
          alert('Silakan login kembali.');
          window.location.href = '/admin/login';
          return;
        }

        const token = await user.getIdToken();
        const isEdit = !!modalId.value;
        const endpoint = '/api/admin/categories';
        const method = isEdit ? 'PUT' : 'POST';

        const payload: Record<string, any> = {
          name: modalName.value.trim(),
          slug: modalSlug.value.trim(),
          sortOrder: parseInt(modalOrder.value || '1', 10),
          active: modalActive.value === 'true',
        };
        if (isEdit) payload.id = modalId.value;

        try {
          const res = await fetch(endpoint, {
            method,
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (res.ok) {
            window.location.reload();
          } else {
            alert(`Gagal: ${data.error || 'Terjadi kesalahan'}`);
          }
        } catch (err: any) {
          alert(`Gagal: ${err.message}`);
        }
      });
    }

    // Hapus Kategori dengan Pengecekan Integritas Penggunaan
    const deleteModal = document.getElementById('delete-cat-modal');
    const deleteDesc = document.getElementById('delete-cat-desc');
    const deleteCancel = document.getElementById('delete-cat-cancel');
    const deleteConfirm = document.getElementById('delete-cat-confirm') as HTMLButtonElement;
    let selectedCatId: string | null = null;

    document.querySelectorAll('.btn-delete-cat').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const t = e.currentTarget as HTMLElement;
        const id = t.dataset.id || '';
        const name = t.dataset.name || '';
        const usage = parseInt(t.dataset.usage || '0', 10);

        selectedCatId = id;

        if (usage > 0) {
          if (deleteDesc) {
            deleteDesc.innerHTML = `<span class="text-red-600 font-bold">PERINGATAN:</span> Kategori <strong>"${name}"</strong> saat ini masih digunakan oleh <strong>${usage} UMKM</strong>. Anda tidak dapat menghapus kategori ini sebelum seluruh UMKM terkait dipindahkan ke kategori lain.`;
          }
          if (deleteConfirm) deleteConfirm.classList.add('hidden');
        } else {
          if (deleteDesc) {
            deleteDesc.innerHTML = `Apakah Anda yakin ingin menghapus kategori <strong>"${name}"</strong>? Kategori ini tidak sedang digunakan oleh UMKM mana pun.`;
          }
          if (deleteConfirm) deleteConfirm.classList.remove('hidden');
        }

        deleteModal?.classList.remove('hidden');
      });
    });

    deleteCancel?.addEventListener('click', () => deleteModal?.classList.add('hidden'));

    if (deleteConfirm) {
      deleteConfirm.addEventListener('click', async () => {
        if (!selectedCatId) return;
        const auth = getClientAuth();
        const user = auth.currentUser;
        if (!user) return;

        deleteConfirm.textContent = 'Menghapus...';
        const token = await user.getIdToken();

        try {
          const res = await fetch('/api/admin/categories', {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ id: selectedCatId }),
          });

          const data = await res.json();
          if (res.ok) {
            window.location.reload();
          } else {
            alert(`Gagal menghapus: ${data.error || 'Terjadi kesalahan'}`);
          }
        } catch (err: any) {
          alert(`Gagal: ${err.message}`);
        } finally {
          deleteConfirm.textContent = 'Ya, Hapus';
          deleteModal?.classList.add('hidden');
        }
      });
    }
  </script>
</AdminLayout>
