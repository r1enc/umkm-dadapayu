---
import Layout from '../layouts/Layout.astro';
import UMKMCard from '../components/UMKMCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { fetchCategories } from '../lib/services/categoryService';
import { fetchPublishedUMKM } from '../lib/services/umkmService';
import { loadCatalogData } from '../lib/services/publicDataCore.mjs';
import type { Category, UMKM } from '../types';

// Query parameters from URL (Server-Side)
const searchParams = Astro.url.searchParams;
const queryParam = searchParams.get('q') || '';
const categoryParam = searchParams.get('kategori') || 'semua';

let categories: Category[] = [];
let allPublished: UMKM[] = [];
let filteredUMKM: UMKM[] = [];
let total = 0;
let activeCategory: Category | undefined;
let catalogError = '';
try {
  ({ categories, allPublished, items: filteredUMKM, total, category: activeCategory } = await loadCatalogData(
    fetchCategories,
    fetchPublishedUMKM,
    { query: queryParam, categorySlug: categoryParam },
  ));
} catch (error) {
  console.error('[Catalog] Firestore catalog request failed:', error);
  catalogError = 'Katalog tidak dapat dimuat dari Firestore. Silakan coba lagi nanti.';
}
const totalAll = allPublished.length;

const pageTitle = activeCategory
  ? `Katalog UMKM: ${activeCategory.name} - Desa Dadapayu`
  : queryParam
  ? `Hasil Pencarian "${queryParam}" - Katalog UMKM Dadapayu`
  : 'Katalog Lengkap UMKM Desa Dadapayu, Semanu';
---

<Layout
  title={pageTitle}
  description="Daftar lengkap usaha mikro, kecil, dan menengah di Kalurahan Dadapayu. Cari produk kuliner, kerajinan, dan hasil bumi unggulan warga."
>
  <section class="bg-village-900 text-white">
    <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 sm:py-10 lg:px-8">
      <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#c8e879] sm:text-xs">Etalase usaha · Dadapayu</p>
      <div class="mt-2 flex items-end justify-between gap-3 sm:mt-3">
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight sm:text-4xl">Temukan usaha warga.</h1>
          <p class="mt-1.5 max-w-2xl text-xs leading-relaxed text-village-100 sm:mt-2 sm:text-base">Cari produk, lihat profil pemilik, lalu hubungi langsung untuk bertanya atau memesan.</p>
        </div>
        <span class="shrink-0 rounded-full border border-village-600 px-3 py-1.5 text-[10px] font-semibold text-white sm:px-4 sm:py-2 sm:text-sm">{totalAll} UMKM</span>
      </div>
    </div>
  </section>

  <section class="bg-village-50 py-8 sm:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Bar Pencarian & Filter Kategori -->
      <div class="space-y-4 rounded-[1.35rem] border border-village-200 border-b-4 border-b-primary-500 bg-white p-3.5 shadow-md sm:space-y-6 sm:rounded-[1.5rem] sm:p-6">
        <!-- Form Search Utama -->
        <form id="catalog-search-form" action="/katalog" method="GET" class="flex items-center gap-2">
          <div class="relative flex-1">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input
              id="search-input"
              type="text"
              name="q"
              value={queryParam}
              placeholder="Cari nama usaha atau produk"
              class="w-full min-w-0 rounded-xl border border-village-200 bg-village-50 py-3 pl-11 pr-4 text-sm text-gray-900 focus:border-village-600 focus:outline-none focus:ring-1 focus:ring-village-600 sm:bg-white"
            />
            {queryParam && (
              <a
                href={`/katalog${categoryParam !== 'semua' ? `?kategori=${categoryParam}` : ''}`}
                class="absolute inset-y-0 right-0 flex items-center pr-3 text-xs text-gray-400 hover:text-gray-600"
                title="Hapus pencarian kata kunci"
              >
                ✕ Hapus
              </a>
            )}
          </div>

          <!-- Hidden Input untuk menjaga kategori terpilih saat submit text search -->
          <input type="hidden" name="kategori" value={categoryParam} />

          <button
            type="submit"
            class="min-h-11 shrink-0 rounded-xl bg-village-900 px-3.5 py-3 text-xs font-semibold text-white transition hover:bg-village-700 sm:px-6 sm:text-sm"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span>Cari</span>
          </button>
        </form>

        <!-- Filter Tab Kategori (Pill Buttons) -->
        <div>
          <div class="flex items-center justify-between pb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-gray-500">Filter Kategori:</span>
            {(queryParam || categoryParam !== 'semua') && (
              <a href="/katalog" class="text-xs font-semibold text-village-700 hover:underline">
                Reset Semua Filter
              </a>
            )}
          </div>
          <div class="flex flex-nowrap items-center gap-2 overflow-x-auto pb-1 sm:flex-wrap sm:overflow-visible">
            <a
              href={`/katalog${queryParam ? `?q=${encodeURIComponent(queryParam)}` : ''}`}
              class:list={[
                'shrink-0 whitespace-nowrap rounded-full px-4 py-2 text-xs font-medium transition-colors sm:text-sm',
                categoryParam === 'semua'
                  ? 'bg-village-700 text-white shadow-xs'
                  : 'bg-gray-100 text-gray-700 hover:bg-gray-200',
              ]}
            >
              Semua Kategori ({totalAll})
            </a>
            {categories.map((cat) => {
              const isActive = categoryParam === cat.slug;
              const linkUrl = `/katalog?kategori=${cat.slug}${queryParam ? `&q=${encodeURIComponent(queryParam)}` : ''}`;
              return (
                <a
                  href={linkUrl}
                  class:list={[
                    'shrink-0 whitespace-nowrap rounded-full px-4 py-2 text-xs font-medium transition-colors sm:text-sm',
                    isActive
                      ? 'bg-village-700 text-white shadow-xs'
                      : 'bg-gray-100 text-gray-700 hover:bg-gray-200',
                  ]}
                >
                  {cat.name}
                </a>
              );
            })}
          </div>
        </div>
      </div>

      {catalogError && <p class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">{catalogError}</p>}

      <!-- Ringkasan Hasil -->
      <div class="flex items-center justify-between py-6">
        <p id="results-count" class="text-xs sm:text-sm text-gray-600 font-medium">
          Menampilkan <span class="font-bold text-gray-900">{total}</span> UMKM
          {activeCategory && <span> dalam kategori <span class="font-bold text-village-800">"{activeCategory.name}"</span></span>}
          {queryParam && <span> dengan kata kunci <span class="font-bold text-village-800">"{queryParam}"</span></span>}
        </p>
      </div>

      <!-- Grid Daftar UMKM -->
      {!catalogError && filteredUMKM.length > 0 ? (
        <div id="umkm-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 xl:grid-cols-3 xl:gap-7">
          {filteredUMKM.map((umkm) => (
            <div
              class="umkm-card-item"
              data-name={umkm.name.toLowerCase()}
              data-desc={umkm.shortDescription.toLowerCase()}
              data-category={umkm.categoryId}
              data-products={umkm.products.map((p) => p.name.toLowerCase()).join(' ')}
            >
              <UMKMCard umkm={umkm} categoryName={categories.find((cat) => cat.id === umkm.categoryId)?.name} />
            </div>
          ))}
        </div>
      ) : !catalogError ? (
        <EmptyState
          title={allPublished.length === 0 ? 'Belum Ada UMKM' : 'Tidak Ada UMKM yang Sesuai'}
          message={allPublished.length === 0 ? 'Belum ada UMKM yang dipublikasikan di katalog.' : `Pencarian "${queryParam || activeCategory?.name || ''}" tidak menemukan hasil. Silakan periksa ejaan kata atau reset filter kategori.`}
          resetUrl="/katalog"
          resetLabel="Lihat Seluruh UMKM Dadapayu"
        />
      ) : null}

      <!-- Kontainer Empty State untuk filter instan client-side -->
      <div id="client-empty-state" class="hidden">
        <EmptyState
          title="Pencarian Tidak Ditemukan"
          message="Tidak ada UMKM atau produk yang cocok dengan kata kunci yang Anda ketikkan."
          resetUrl="/katalog"
          resetLabel="Reset Pencarian"
        />
      </div>
    </div>
  </section>
</Layout>

<!-- Progressive Client-side Instant Filter Enhancement (Zero heavy framework) -->
<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const cards = document.querySelectorAll<HTMLElement>('.umkm-card-item');
  const countEl = document.getElementById('results-count');
  const clientEmptyEl = document.getElementById('client-empty-state');
  const gridEl = document.getElementById('umkm-grid');

  if (searchInput && cards.length > 0) {
    searchInput.addEventListener('input', () => {
      const term = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = card.dataset.name || '';
        const desc = card.dataset.desc || '';
        const products = card.dataset.products || '';
        const matches = name.includes(term) || desc.includes(term) || products.includes(term);

        if (matches) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countEl) {
        countEl.innerHTML = `Menampilkan <span class="font-bold text-gray-900">${visibleCount}</span> UMKM`;
      }

      if (visibleCount === 0) {
        if (clientEmptyEl) clientEmptyEl.classList.remove('hidden');
        if (gridEl) gridEl.classList.add('hidden');
      } else {
        if (clientEmptyEl) clientEmptyEl.classList.add('hidden');
        if (gridEl) gridEl.classList.remove('hidden');
      }
    });
  }
</script>
