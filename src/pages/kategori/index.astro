---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { fetchCategories } from '../../lib/services/categoryService';
import { fetchPublishedUMKM } from '../../lib/services/umkmService';

const categories = await fetchCategories();
const allPublished = await fetchPublishedUMKM();
const totalUMKM = allPublished.length;

const breadcrumbItems = [
  { name: 'Kategori Usaha' },
];

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=120'
);
---

<Layout
  title="Kategori Usaha UMKM Desa Dadapayu, Semanu, Gunungkidul"
  description="Daftar sektor dan kategori usaha mikro, kecil, dan menengah di Kalurahan Dadapayu: kuliner tradisional, kerajinan bambu & kayu, hasil tani, dan warung lokal."
>
  <div class="bg-gray-50 border-b border-gray-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4">
      <Breadcrumb items={breadcrumbItems} />
      <div class="pt-2 pb-6">
        <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
          Kategori Usaha Desa Dadapayu
        </h1>
        <p class="mt-2 text-sm sm:text-base text-gray-600 max-w-3xl">
          Telusuri produk dan jasa unggulan desa berdasarkan kelompok industri dan bidang usaha. Total {totalUMKM} UMKM terdaftar dan siap melayani pesanan Anda.
        </p>
      </div>
    </div>
  </div>

  <section class="py-12 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-6">
        {categories.map((cat) => (
          <div class="flex flex-col justify-between rounded-3xl border border-gray-200/90 bg-gray-50/40 p-6 sm:p-8 hover:border-village-300 hover:shadow-sm transition">
            <div class="space-y-4">
              <CategoryCard category={cat} />
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed pl-1">
                Kumpulan pelaku usaha warga Dadapayu di bidang {cat.name.toLowerCase()} dengan keaslian bahan baku lokal dan kualitas terpercaya.
              </p>
            </div>
            <div class="pt-6 mt-4 border-t border-gray-200/60 flex items-center justify-between">
              <span class="text-xs text-gray-500 font-medium">Sektor Unggulan Desa</span>
              <a
                href={`/kategori/${cat.slug}`}
                class="inline-flex items-center gap-1.5 rounded-xl bg-village-700 px-4 py-2 text-xs font-semibold text-white shadow-xs hover:bg-village-800 transition"
              >
                <span>Lihat Daftar Usaha</span>
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
