---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import UMKMCard from '../../components/UMKMCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { fetchCategoryBySlug } from '../../lib/services/categoryService';
import { fetchUMKMByCategory } from '../../lib/services/umkmService';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/kategori');
}

const category = await fetchCategoryBySlug(slug);

if (!category) {
  Astro.response.status = 404;
  return Astro.redirect('/404');
}

const umkmList = await fetchUMKMByCategory(category.id);

const breadcrumbItems = [
  { name: 'Kategori Usaha', url: '/kategori' },
  { name: category.name },
];

---

<Layout
  title={`Kategori ${category.name} - UMKM Desa Dadapayu`}
  description={`Daftar UMKM dan produk lokal dalam bidang ${category.name} di Kalurahan Dadapayu, Semanu, Gunungkidul.`}
>
  <div class="bg-gray-50 border-b border-gray-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4">
      <Breadcrumb items={breadcrumbItems} />
      <div class="pt-2 pb-6">
        <div class="inline-flex items-center gap-2 rounded-full bg-village-100 px-3 py-1 text-xs font-semibold text-village-800 mb-2">
          Kategori Pilihan
        </div>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
          {category.name}
        </h1>
        <p class="mt-2 text-sm sm:text-base text-gray-600 max-w-3xl">
          Menampilkan seluruh pelaku usaha dan pengrajin Dadapayu yang terdaftar di bidang {category.name.toLowerCase()}.
        </p>
      </div>
    </div>
  </div>

  <section class="py-10 sm:py-14 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- Bar Tindakan -->
      <div class="flex items-center justify-between pb-6 border-b border-gray-100 mb-8">
        <p class="text-xs sm:text-sm text-gray-600 font-medium">
          Ditemukan <span class="font-bold text-gray-900">{umkmList.length}</span> UMKM
        </p>
        <a
          href="/katalog"
          class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-village-700 hover:underline"
        >
          <span>Buka Semua Katalog</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Grid UMKM -->
      {umkmList.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {umkmList.map((umkm) => (
            <UMKMCard umkm={umkm} />
          ))}
        </div>
      ) : (
        <EmptyState
          title={`Belum Ada UMKM di Kategori ${category.name}`}
          message="Saat ini belum ada pelaku usaha yang terdaftar di kategori ini. Silakan cek kategori lain."
          resetUrl="/katalog"
          resetLabel="Kembali ke Seluruh Katalog"
        />
      )}

    </div>
  </section>
</Layout>
