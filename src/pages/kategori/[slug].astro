---
import Layout from '../../layouts/Layout.astro';
import UMKMCard from '../../components/UMKMCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { fetchCategoryBySlug } from '../../lib/services/categoryService';
import { fetchUMKMByCategory } from '../../lib/services/umkmService';
import type { Category, UMKM } from '../../types';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/kategori');
}

let category: Category | undefined;
let catalogError = '';
try {
  category = await fetchCategoryBySlug(slug);
} catch (error) {
  console.error('[CategoryPage] Firestore category request failed:', error);
  catalogError = 'Kategori tidak dapat dimuat dari Firestore. Silakan coba lagi nanti.';
}

if (!category) {
  if (catalogError) {
    Astro.response.status = 503;
  } else {
  Astro.response.status = 404;
  return Astro.redirect('/404');
  }
}

let umkmList: UMKM[] = [];
if (category) {
  try {
    umkmList = await fetchUMKMByCategory(category.id);
  } catch (error) {
    console.error('[CategoryPage] Firestore UMKM request failed:', error);
    catalogError = 'Daftar UMKM pada kategori ini tidak dapat dimuat dari Firestore. Silakan coba lagi nanti.';
  }
}

---

<Layout
  title={`${category ? `Kategori ${category.name}` : 'Kategori'} - UMKM Desa Dadapayu`}
  description={category ? `Daftar UMKM dalam bidang ${category.name} di Kalurahan Dadapayu.` : 'Informasi kategori tidak tersedia.'}
>
  <header class="bg-[#c8e879] text-village-900">
    <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 sm:py-10 lg:px-8">
      <a href="/kategori" class="inline-flex min-h-9 items-center gap-1 text-xs font-semibold text-village-800 underline underline-offset-4">← Semua kategori</a>
      <div class="mt-2 flex items-end justify-between gap-3">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.18em] sm:text-xs">Kategori usaha</p>
          <h1 class="mt-1 text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">{category?.name || 'Kategori usaha'}</h1>
        </div>
        <span class="shrink-0 rounded-full bg-village-900 px-3 py-1.5 text-[10px] font-semibold text-white sm:px-4 sm:py-2 sm:text-sm">{umkmList.length} UMKM</span>
      </div>
      <p class="mt-2 text-xs leading-relaxed text-village-800 sm:text-base">{catalogError || `Kenali usaha yang bergerak di bidang ${category?.name || ''} di Dadapayu.`}</p>
    </div>
  </header>

  <section class="bg-village-50 py-8 sm:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- Bar Tindakan -->
      {catalogError && <p class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">{catalogError}</p>}
      <div class="mb-6 flex items-center justify-between rounded-2xl border border-village-200 bg-white px-4 py-4 shadow-sm sm:mb-8 sm:px-6">
        <p class="text-xs sm:text-sm text-gray-600 font-medium">
          Ditemukan <span class="font-bold text-gray-900">{umkmList.length}</span> UMKM
        </p>
        <a
          href="/katalog"
          class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-village-700 hover:underline"
        >
          <span>Buka Semua Katalog</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Grid UMKM -->
      {umkmList.length > 0 ? (
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 xl:grid-cols-3">
          {umkmList.map((umkm) => (
            <UMKMCard umkm={umkm} categoryName={category?.name} />
          ))}
        </div>
      ) : !catalogError ? (
        <EmptyState
          title={`Belum Ada UMKM di Kategori ${category?.name || ''}`}
          message="Saat ini belum ada UMKM yang dipublikasikan pada kategori ini."
          resetUrl="/katalog"
          resetLabel="Kembali ke Seluruh Katalog"
        />
      ) : null}

    </div>
  </section>
</Layout>
